// Object Detection Robot — fixed sweep timing + wire tangle prevention

#include <Servo.h>

// ── Motor pins ────────────────────────────────────────────────────────────────
#define enA 10
#define in1 6
#define in2 3
#define in3 5
#define in4 4
#define enB 11

// ── Ultrasonic pins ───────────────────────────────────────────────────────────
#define TRIG_PIN 7
#define ECHO_PIN 8

// ── Servo ─────────────────────────────────────────────────────────────────────
#define SERVO_PIN 9
Servo sonarServo;

#define SERVO_STOP  90   // tune 89 or 91 if it still drifts
#define SERVO_CW    75   // forward sweep direction (always CW)
#define SERVO_CCW  105   // used ONLY for fast rewind

// ── Sweep config ──────────────────────────────────────────────────────────────
// TIME_FOR_180_MS: write SERVO_CW, time a 180° arc with a stopwatch, use that value.
#define TIME_FOR_180_MS  1000   // ← TUNE THIS

#define NUM_ANGLES 9
// Each step must account for readUltrasonic() taking up to 30ms.
// STEP_DELAY is the extra wait ON TOP of the sensor read time.
const int SENSOR_READ_MS = 30;   // pulseIn timeout ceiling
const int STEP_DELAY = (TIME_FOR_180_MS / NUM_ANGLES) - SENSOR_READ_MS;

// ── Depth map ─────────────────────────────────────────────────────────────────
float depthMap[NUM_ANGLES];

// ── Tuning ────────────────────────────────────────────────────────────────────
const float CLOSE_ENOUGH_CM = 12.0;
const int   DRIVE_SPEED     = 110;
const int   TURN_SPEED      = 120;
const float MS_PER_DEGREE   = 7.0;   // ← TUNE: run turnByDegrees(90), check actual angle

// ── Drive duration between re-sweeps ─────────────────────────────────────────
#define DRIVE_DURATION_MS 800

// ── State machine ─────────────────────────────────────────────────────────────
enum State { SWEEP, DRIVE_FORWARD };
State robotState = SWEEP;

// ─────────────────────────────────────────────────────────────────────────────
void setup() {
  Serial.begin(9600);

  pinMode(enA, OUTPUT); pinMode(in1, OUTPUT); pinMode(in2, OUTPUT);
  pinMode(in3, OUTPUT); pinMode(in4, OUTPUT); pinMode(enB, OUTPUT);
  stopMotors();

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  sonarServo.attach(SERVO_PIN);
  sonarServo.write(SERVO_STOP);
  delay(500);

  if (STEP_DELAY <= 0) {
    Serial.println("WARNING: TIME_FOR_180_MS too small — increase it!");
  }
  Serial.println("Ready.");
}

// ─────────────────────────────────────────────────────────────────────────────
void loop() {
  switch (robotState) {

    case SWEEP: {
      doSweep();
      printMap();

      int targetIdx = findClosest();
      // Index 0 = -90° (left), index 4 = 0° (forward), index 8 = +90° (right)
      // Sweep is always CW, so index order is always left→right. No flip needed.
      float turnDeg = indexToAngle(targetIdx);

      Serial.print("Closest at index "); Serial.print(targetIdx);
      Serial.print(" -> turn ");         Serial.print(turnDeg);
      Serial.print("°  dist ");          Serial.print(depthMap[targetIdx]);
      Serial.println(" cm");

      if (depthMap[targetIdx] <= CLOSE_ENOUGH_CM) {
        Serial.println("Already close enough!");
        stopMotors();
        delay(2000);
      } else {
        turnByDegrees(turnDeg);
        delay(150);
        robotState = DRIVE_FORWARD;
      }
      break;
    }

    case DRIVE_FORWARD: {
      Serial.println("Driving...");
      driveForward();
      delay(DRIVE_DURATION_MS);
      stopMotors();
      delay(150);
      robotState = SWEEP;
      break;
    }
  }
}

// ─────────────────────────────────────────────────────────────────────────────
// Always sweeps CW (left → right), then fast-rewinds CCW to start position.
// This prevents wires from accumulating twist over multiple sweeps.
void doSweep() {
  Serial.println("Sweeping CW...");
  sonarServo.write(SERVO_CW);

  for (int i = 0; i < NUM_ANGLES; i++) {
    // Read FIRST, then wait — so the delay pads the gap between readings,
    // not before the first one. Keeps timing consistent.
    depthMap[i] = readUltrasonic();
    if (STEP_DELAY > 0) delay(STEP_DELAY);
  }

  sonarServo.write(SERVO_STOP);
  delay(200);

  // ── Rewind: spin CCW for the same duration to return to start ──────────────
  Serial.println("Rewinding...");
  sonarServo.write(SERVO_CCW);
  delay(TIME_FOR_180_MS);
  sonarServo.write(SERVO_STOP);
  delay(300);   // let it settle before next sweep
}

// ─────────────────────────────────────────────────────────────────────────────
int findClosest() {
  int best = 0;
  for (int i = 1; i < NUM_ANGLES; i++)
    if (depthMap[i] < depthMap[best]) best = i;
  return best;
}

// ─────────────────────────────────────────────────────────────────────────────
// Index 0 = -90° (left of robot), index 4 = 0° (straight ahead), index 8 = +90° (right)
float indexToAngle(int idx) {
  return -90.0 + idx * (180.0 / (NUM_ANGLES - 1));
}

// ─────────────────────────────────────────────────────────────────────────────
float readUltrasonic() {
  digitalWrite(TRIG_PIN, LOW);  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH); delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);
  long dur = pulseIn(ECHO_PIN, HIGH, 30000);
  if (dur == 0) return 400.0;
  return dur * 0.034 / 2.0;
}

// ─────────────────────────────────────────────────────────────────────────────
void driveForward() {
  analogWrite(enA, DRIVE_SPEED); analogWrite(enB, DRIVE_SPEED);
  digitalWrite(in1, HIGH); digitalWrite(in2, LOW);
  digitalWrite(in3, LOW);  digitalWrite(in4, HIGH);
}

void stopMotors() {
  digitalWrite(in1, LOW); digitalWrite(in2, LOW);
  digitalWrite(in3, LOW); digitalWrite(in4, LOW);
}

// Positive deg = turn right, negative deg = turn left
void turnByDegrees(float deg) {
  if (abs(deg) < 4) return;
  int ms = abs((int)(deg * MS_PER_DEGREE));
  analogWrite(enA, TURN_SPEED); analogWrite(enB, TURN_SPEED);
  if (deg > 0) {                            // turn right: A backward, B forward
    digitalWrite(in1, LOW);  digitalWrite(in2, HIGH);
    digitalWrite(in3, LOW);  digitalWrite(in4, HIGH);
  } else {                                  // turn left: A forward, B backward
    digitalWrite(in1, HIGH); digitalWrite(in2, LOW);
    digitalWrite(in3, HIGH); digitalWrite(in4, LOW);
  }
  delay(ms);
  stopMotors();
}

// ─────────────────────────────────────────────────────────────────────────────
void printMap() {
  Serial.println("Idx | Angle  | Distance");
  for (int i = 0; i < NUM_ANGLES; i++) {
    Serial.print(i);
    Serial.print("   |  ");
    Serial.print(indexToAngle(i), 1);
    Serial.print("°  |  ");
    Serial.print(depthMap[i], 1);
    Serial.println(" cm");
  }
  Serial.println("---");
}
