// Object Detection Robot
// Sweeps 180° back and forth (windshield wiper), drives toward closest object.

#include <Servo.h>

// ── Motor pins ────────────────────────────────────────────────────────────────
#define enA 10
#define in1 6
#define in2 3
#define in3 5
#define in4 4
#define enB 11

// ── Ultrasonic pins ───────────────────────────────────────────────────────────
#define TRIG_PIN 7
#define ECHO_PIN 8

// ── Servo ─────────────────────────────────────────────────────────────────────
#define SERVO_PIN 9
Servo sonarServo;

// Tune SERVO_STOP until the servo truly doesn't move.
// Try 89 or 91 if it drifts.
#define SERVO_STOP 90
#define SERVO_CW   75    // spins one way
#define SERVO_CCW  105   // spins the other way

// ── Sweep config ──────────────────────────────────────────────────────────────
// Measure: write SERVO_CW, time a full 360°, divide by 2 for 180°.
#define TIME_FOR_180_MS 1000   // ← TUNE THIS

#define NUM_ANGLES 9           // 9 readings across 180° = 22.5° steps
const int STEP_DELAY = TIME_FOR_180_MS / NUM_ANGLES;

// ── Depth map ─────────────────────────────────────────────────────────────────
float depthMap[NUM_ANGLES];

// ── Tuning ────────────────────────────────────────────────────────────────────
const float CLOSE_ENOUGH_CM = 12.0;  // stop when this close to object
const int   DRIVE_SPEED     = 110;
const int   TURN_SPEED      = 120;
const float MS_PER_DEGREE   = 7.0;   // ← TUNE: run turnByDegrees(90), measure actual degrees

// ── Drive duration between re-sweeps ─────────────────────────────────────────
#define DRIVE_DURATION_MS 800

// ── State machine ─────────────────────────────────────────────────────────────
enum State { SWEEP, DRIVE_FORWARD };
State robotState = SWEEP;

bool sweepCW = true;   // alternates each sweep for windshield wiper motion

// ─────────────────────────────────────────────────────────────────────────────
void setup() {
  Serial.begin(9600);

  pinMode(enA, OUTPUT); pinMode(in1, OUTPUT); pinMode(in2, OUTPUT);
  pinMode(in3, OUTPUT); pinMode(in4, OUTPUT); pinMode(enB, OUTPUT);
  stopMotors();

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  sonarServo.attach(SERVO_PIN);
  sonarServo.write(SERVO_STOP);
  delay(500);
  Serial.println("Ready.");
}

// ─────────────────────────────────────────────────────────────────────────────
void loop() {
  switch (robotState) {

    case SWEEP: {
      doSweep();
      printMap();

      int targetIdx = findClosest();

      // Index 0 = -90° (left), index 4 = 0° (forward), index 8 = +90° (right).
      // When sweeping CCW the array is filled right-to-left, so flip the index.
      int mappedIdx = sweepCW ? targetIdx : (NUM_ANGLES - 1 - targetIdx);
      float turnDeg = indexToAngle(mappedIdx);

      Serial.print("Closest at index "); Serial.print(targetIdx);
      Serial.print(" -> car angle ");    Serial.print(turnDeg);
      Serial.print("°  dist ");         Serial.print(depthMap[targetIdx]);
      Serial.println(" cm");

      // Alternate sweep direction for next time
      sweepCW = !sweepCW;

      if (depthMap[targetIdx] <= CLOSE_ENOUGH_CM) {
        Serial.println("Already close enough!");
        stopMotors();
        delay(2000);
      } else {
        turnByDegrees(turnDeg);
        delay(150);
        robotState = DRIVE_FORWARD;
      }
      break;
    }

    case DRIVE_FORWARD: {
      Serial.println("Driving...");
      driveForward();
      delay(DRIVE_DURATION_MS);
      stopMotors();
      delay(150);
      robotState = SWEEP;
      break;
    }
  }
}

// ─────────────────────────────────────────────────────────────────────────────
void doSweep() {
  Serial.print("Sweeping "); Serial.println(sweepCW ? "CW" : "CCW");
  sonarServo.write(sweepCW ? SERVO_CW : SERVO_CCW);

  for (int i = 0; i < NUM_ANGLES; i++) {
    delay(STEP_DELAY);
    depthMap[i] = readUltrasonic();
  }

  sonarServo.write(SERVO_STOP);
  delay(200);
}

// ─────────────────────────────────────────────────────────────────────────────
int findClosest() {
  int best = 0;
  for (int i = 1; i < NUM_ANGLES; i++)
    if (depthMap[i] < depthMap[best]) best = i;
  return best;
}

// ─────────────────────────────────────────────────────────────────────────────
float indexToAngle(int idx) {
  return -90.0 + idx * (180.0 / (NUM_ANGLES - 1));
}

// ─────────────────────────────────────────────────────────────────────────────
float readUltrasonic() {
  digitalWrite(TRIG_PIN, LOW);  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH); delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);
  long dur = pulseIn(ECHO_PIN, HIGH, 30000);
  if (dur == 0) return 400.0;
  return dur * 0.034 / 2.0;
}

// ─────────────────────────────────────────────────────────────────────────────
void driveForward() {
  analogWrite(enA, DRIVE_SPEED); analogWrite(enB, DRIVE_SPEED);
  digitalWrite(in1, HIGH); digitalWrite(in2, LOW);
  digitalWrite(in3, LOW);  digitalWrite(in4, HIGH);
}

void stopMotors() {
  digitalWrite(in1, LOW); digitalWrite(in2, LOW);
  digitalWrite(in3, LOW); digitalWrite(in4, LOW);
}

// Positive = turn right, negative = turn left
void turnByDegrees(float deg) {
  if (abs(deg) < 4) return;
  int ms = abs((int)(deg * MS_PER_DEGREE));
  analogWrite(enA, TURN_SPEED); analogWrite(enB, TURN_SPEED);
  if (deg > 0) {
    digitalWrite(in1, LOW);  digitalWrite(in2, HIGH);
    digitalWrite(in3, LOW);  digitalWrite(in4, HIGH);
  } else {
    digitalWrite(in1, HIGH); digitalWrite(in2, LOW);
    digitalWrite(in3, HIGH); digitalWrite(in4, LOW);
  }
  delay(ms);
  stopMotors();
}

// ─────────────────────────────────────────────────────────────────────────────
void printMap() {
  Serial.println("Idx | Angle  | Distance");
  for (int i = 0; i < NUM_ANGLES; i++) {
    int mappedIdx = sweepCW ? i : (NUM_ANGLES - 1 - i);
    Serial.print(i);
    Serial.print("   |  ");
    Serial.print(indexToAngle(mappedIdx), 1);
    Serial.print("°  |  ");
    Serial.print(depthMap[i], 1);
    Serial.println(" cm");
  }
  Serial.println("---");
}
