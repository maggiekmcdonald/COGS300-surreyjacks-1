// Arduino Line Follower Robot Code - Improved for Sharp Zigzag Turns
// Original: https://circuitdigest.com/microcontroller-projects/arduino-uno-line-follower-robot
//
// CHANGES FROM ORIGINAL:
// 1. Added "lastTurn" variable to remember which direction we last corrected toward.
//    When both sensors lose the line, we keep turning that direction instead of
//    going straight (which caused the robot to overshoot on sharp angles).
// 2. Added a timeout-based reverse fallback: if we've been searching for the line
//    for too long (SEARCH_TIMEOUT_MS), we reverse briefly then resume searching.
//    This handles cases where memory-based turning alone isn't enough.
// 3. Both-sensors-on-black (stopped on the line) now calls Stop() as originally
//    intended (the original code called turnRight() with a comment saying "Stop").
// 4. Increased turning speeds for sharper pivot during recovery.

#define enA 10  // Enable1 L293 Pin enA
#define in1 6   // Motor1 L293 Pin in1
#define in2 3   // Motor1 L293 Pin in2
#define in3 5   // Motor2 L293 Pin in3
#define in4 4   // Motor2 L293 Pin in4
#define enB 11  // Enable2 L293 Pin enB
#define R_S 12  // IR sensor Right
#define L_S 2   // IR sensor Left

// --- Tunable Parameters ---
int forwardSpeed    = 80;   // PWM speed when going straight
int turnSpeedSlow   = 60;   // inner wheel speed during normal turns
int turnSpeedFast   = 140;  // outer wheel speed during normal turns
int searchSpeed     = 150;  // speed for aggressive searching when line is lost
int reverseSpeed    = 100;  // speed when reversing during fallback

// How long (ms) to keep searching by spinning before we try reversing
unsigned long SEARCH_TIMEOUT_MS = 800;

// How long (ms) to reverse before resuming the search
unsigned long REVERSE_DURATION_MS = 300;

// --- State Variables ---
// 0 = unknown, 1 = last turned right, 2 = last turned left
int lastTurn = 0;

// Tracks when we first lost the line (both sensors white)
unsigned long lostLineTime = 0;
bool searching = false;

void setup() {
  pinMode(R_S, INPUT);
  pinMode(L_S, INPUT);
  pinMode(enA, OUTPUT);
  pinMode(in1, OUTPUT);
  pinMode(in2, OUTPUT);
  pinMode(in3, OUTPUT);
  pinMode(in4, OUTPUT);
  pinMode(enB, OUTPUT);

  analogWrite(enA, forwardSpeed);
  analogWrite(enB, forwardSpeed);
  delay(1000);
}

void loop() {
  int R = digitalRead(R_S);  // 1 = white (no line), 0 = black (line detected)
  int L = digitalRead(L_S);

  if (R == 1 && L == 1) {
    // --- BOTH WHITE: Line is lost ---
    // CHANGE: Instead of going forward (which caused overshoot on sharp turns),
    // we now aggressively turn toward the last known direction to reacquire the line.

    if (!searching) {
      // Just lost the line — start the search timer
      searching = true;
      lostLineTime = millis();
    }

    unsigned long elapsed = millis() - lostLineTime;

    if (elapsed < SEARCH_TIMEOUT_MS) {
      // Phase 1: Spin in the last-known direction to find the line
      if (lastTurn == 1) {
        searchRight();
      } else if (lastTurn == 2) {
        searchLeft();
      } else {
        // No history yet — default to a slow right search
        searchRight();
      }
    } else {
      // Phase 2 (FALLBACK): We've been spinning too long — reverse briefly,
      // then reset the timer so we try spinning again from a new position.
      reverse();
      delay(REVERSE_DURATION_MS);
      Stop();
      lostLineTime = millis();  // reset so we spin again from new position
    }
  }

  else if (R == 0 && L == 1) {
    // --- RIGHT sensor on line, LEFT on white: turn right ---
    searching = false;       // we found the line
    lastTurn = 1;            // CHANGE: remember we turned right
    turnRight();
  }

  else if (R == 1 && L == 0) {
    // --- LEFT sensor on line, RIGHT on white: turn left ---
    searching = false;
    lastTurn = 2;            // CHANGE: remember we turned left
    turnLeft();
  }

  else if (R == 0 && L == 0) {
    // --- BOTH BLACK: sitting right on the line ---
    // CHANGE: Original code called turnRight() here (comment said "Stop").
    // Now we go forward since both sensors on the line means we're centered.
    searching = false;
    forward();
  }
}

// --- Motor Functions ---

void forward() {
  analogWrite(enA, forwardSpeed);
  analogWrite(enB, forwardSpeed);
  digitalWrite(in1, HIGH);
  digitalWrite(in2, LOW);
  digitalWrite(in3, LOW);
  digitalWrite(in4, HIGH);
}

void turnRight() {
  // Differential turn: slow right, fast left
  analogWrite(enA, turnSpeedSlow);
  analogWrite(enB, turnSpeedFast);
  digitalWrite(in1, LOW);
  digitalWrite(in2, HIGH);
  digitalWrite(in3, LOW);
  digitalWrite(in4, HIGH);
}

void turnLeft() {
  // Differential turn: fast right, slow left
  analogWrite(enA, turnSpeedFast);
  analogWrite(enB, turnSpeedSlow);
  digitalWrite(in1, HIGH);
  digitalWrite(in2, LOW);
  digitalWrite(in3, HIGH);
  digitalWrite(in4, LOW);
}

// CHANGE: New function — aggressive in-place right spin for line recovery
void searchRight() {
  analogWrite(enA, searchSpeed);
  analogWrite(enB, searchSpeed);
  // Right motor backward, left motor forward = pivot right
  digitalWrite(in1, LOW);
  digitalWrite(in2, HIGH);
  digitalWrite(in3, LOW);
  digitalWrite(in4, HIGH);
}

// CHANGE: New function — aggressive in-place left spin for line recovery
void searchLeft() {
  analogWrite(enA, searchSpeed);
  analogWrite(enB, searchSpeed);
  // Right motor forward, left motor backward = pivot left
  digitalWrite(in1, HIGH);
  digitalWrite(in2, LOW);
  digitalWrite(in3, HIGH);
  digitalWrite(in4, LOW);
}

// CHANGE: New function — reverse briefly (used as fallback during search)
void reverse() {
  analogWrite(enA, reverseSpeed);
  analogWrite(enB, reverseSpeed);
  // Both motors backward
  digitalWrite(in1, LOW);
  digitalWrite(in2, HIGH);
  digitalWrite(in3, HIGH);
  digitalWrite(in4, LOW);
}

void Stop() {
  digitalWrite(in1, LOW);
  digitalWrite(in2, LOW);
  digitalWrite(in3, LOW);
  digitalWrite(in4, LOW);
}
