// Arduino Line Follower Robot Code - V3
// Original: https://circuitdigest.com/microcontroller-projects/arduino-uno-line-follower-robot
//
// CHANGES FROM ORIGINAL:
// Only the both-white case is changed. All motor functions, speeds, and
// pin logic are identical to the original working code.
// 1. Grace period: when both sensors go white, the robot continues its last
//    motor command for GRACE_MS before doing anything different.
// 2. After grace expires, aggressive in-place pivot toward last turn direction.
// 3. If pivot doesn't find the line within SEARCH_TIMEOUT_MS, reverse briefly
//    and try again.

#define enA 10
#define in1 6
#define in2 3
#define in3 5
#define in4 4
#define enB 11
#define R_S 12
#define L_S 2

// --- Tunable recovery parameters ---
unsigned long GRACE_MS          = 150;  // coast on last command before searching
unsigned long SEARCH_TIMEOUT_MS = 800;  // pivot duration before reversing
unsigned long REVERSE_DURATION_MS = 300;
int searchSpeed = 150;
int reverseSpeed = 100;

// --- State ---
int lastTurn = 0;  // 1 = right, 2 = left
unsigned long bothWhiteStart = 0;
bool inGrace  = false;
bool inSearch = false;
unsigned long searchStart = 0;

void setup() {
  pinMode(R_S, INPUT);
  pinMode(L_S, INPUT);
  pinMode(enA, OUTPUT);
  pinMode(in1, OUTPUT);
  pinMode(in2, OUTPUT);
  pinMode(in3, OUTPUT);
  pinMode(in4, OUTPUT);
  pinMode(enB, OUTPUT);
  analogWrite(enA, 100);
  analogWrite(enB, 100);
  delay(1000);
}

void loop() {
  int R = digitalRead(R_S);
  int L = digitalRead(L_S);

  // --- Line detected: use original logic exactly ---

  if (R == 0 && L == 1) {
    // Right sensor on line → turn right (original behavior)
    inGrace = false;
    inSearch = false;
    lastTurn = 1;
    turnRight();
  }
  else if (R == 1 && L == 0) {
    // Left sensor on line → turn left (original behavior)
    inGrace = false;
    inSearch = false;
    lastTurn = 2;
    turnLeft();
  }
  else if (R == 0 && L == 0) {
    // Both on line → stop (original behavior)
    inGrace = false;
    inSearch = false;
    Stop();
  }

  // --- Both white: NEW recovery logic ---

  else if (R == 1 && L == 1) {

    if (!inGrace && !inSearch) {
      // Just lost the line — start grace timer
      inGrace = true;
      bothWhiteStart = millis();
    }

    if (inGrace) {
      if (millis() - bothWhiteStart < GRACE_MS) {
        // Grace window: do nothing, let motors continue as-is
        // (forward() was called by original code on this condition)
        forward();
      } else {
        // Grace expired — enter search mode
        inGrace = false;
        inSearch = true;
        searchStart = millis();
      }
    }

    if (inSearch) {
      unsigned long elapsed = millis() - searchStart;

      if (elapsed < SEARCH_TIMEOUT_MS) {
        if (lastTurn == 1) {
          searchRight();
        } else if (lastTurn == 2) {
          searchLeft();
        } else {
          searchRight();
        }
      } else {
        reverse();
        delay(REVERSE_DURATION_MS);
        Stop();
        searchStart = millis();
      }
    }
  }
}

// === ORIGINAL MOTOR FUNCTIONS — UNCHANGED ===

void forward() {
  analogWrite(enA, 80);
  analogWrite(enB, 80);
  digitalWrite(in1, HIGH);
  digitalWrite(in2, LOW);
  digitalWrite(in3, LOW);
  digitalWrite(in4, HIGH);
}

void turnRight() {
  analogWrite(enA, 90);
  analogWrite(enB, 130);
  digitalWrite(in1, LOW);
  digitalWrite(in2, HIGH);
  digitalWrite(in3, LOW);
  digitalWrite(in4, HIGH);
}

void turnLeft() {
  analogWrite(enA, 130);
  analogWrite(enB, 90);
  digitalWrite(in1, HIGH);
  digitalWrite(in2, LOW);
  digitalWrite(in3, HIGH);
  digitalWrite(in4, LOW);
}

void Stop() {
  digitalWrite(in1, LOW);
  digitalWrite(in2, LOW);
  digitalWrite(in3, LOW);
  digitalWrite(in4, LOW);
}

// === NEW RECOVERY FUNCTIONS ONLY ===

void searchRight() {
  analogWrite(enA, searchSpeed);
  analogWrite(enB, searchSpeed);
  digitalWrite(in1, LOW);
  digitalWrite(in2, HIGH);
  digitalWrite(in3, LOW);
  digitalWrite(in4, HIGH);
}

void searchLeft() {
  analogWrite(enA, searchSpeed);
  analogWrite(enB, searchSpeed);
  digitalWrite(in1, HIGH);
  digitalWrite(in2, LOW);
  digitalWrite(in3, HIGH);
  digitalWrite(in4, LOW);
}

void reverse() {
  analogWrite(enA, reverseSpeed);
  analogWrite(enB, reverseSpeed);
  digitalWrite(in1, LOW);
  digitalWrite(in2, HIGH);
  digitalWrite(in3, HIGH);
  digitalWrite(in4, LOW);
}
